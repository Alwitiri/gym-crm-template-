# Runtime connection: a NON-superuser role without BYPASSRLS, so row-level security applies.
DATABASE_URL=postgresql://gym_app:change-me@localhost:5433/gymcrm
# Used only by `prisma migrate` and the seed script (table owner).
MIGRATE_DATABASE_URL=postgresql://gym_owner:change-me@localhost:5433/gymcrm
# 32+ random bytes. `openssl rand -base64 48`
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
PORT=4000
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_RATE_PER_MINUTE=10
