# HTTPS certificate is fetched and renewed automatically for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
