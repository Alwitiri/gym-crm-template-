# Copy to deploy/.env.prod and fill in. Never commit deploy/.env.prod.
# Make random secrets with:  openssl rand -base64 36

# ---- Server ----
DOMAIN=crm.yourgym.in                 # DNS A record must point at this server first

# ---- Secrets (required) ----
OWNER_DB_PASSWORD=                    # database owner (migrations, backups)
APP_DB_PASSWORD=                      # restricted login the app uses
SESSION_SECRET=                       # 32+ characters

# ---- First-run setup (used once by the "setup" step) ----
GYM_NAME=Your Gym
GYM_LEGAL_NAME=Your Gym Pvt Ltd
GYM_GSTIN=                            # leave empty if not GST-registered
GYM_STATE_CODE=33                     # GST state code, e.g. 33 Tamil Nadu, 32 Kerala, 29 Karnataka
GYM_STATE=Tamil Nadu
BRANCH_CODE=MAIN                      # short, appears in member codes and receipts
BRANCH_NAME=Main branch
BRANCH_ADDRESS=
BRANCH_CITY=
BRANCH_PINCODE=
BRANCH_PHONE=
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=

# ---- Online payments: Razorpay (optional; leave empty to collect at the desk only) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=              # webhook URL: https://DOMAIN/api/v1/webhooks/razorpay, event payment_link.paid

# ---- WhatsApp Business Cloud API (optional; without it staff send from the Messages page) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=                       # permanent system-user token
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Backups ----
BACKUP_HOUR=02                        # 24h, IST
BACKUP_KEEP_DAYS=30
